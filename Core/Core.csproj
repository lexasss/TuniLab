<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>TuniLab.$(MSBuildProjectName)</AssemblyName>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc" />
    <PackageReference Include="Grpc.Reflection" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="protos\common.proto" Link="protos\common.proto" />
    <Protobuf Include="protos\server.proto" Link="protos\server.proto" />
    <Protobuf Include="protos\gaze.proto" Link="protos\gaze.proto" />
    <Protobuf Include="protos\leap.proto" Link="protos\leap.proto" />
    <Protobuf Include="protos\se.proto" Link="protos\se.proto" />
    <Protobuf Include="protos\sound.proto" Link="protos\sound.proto" />
    <Protobuf Include="protos\screen.proto" Link="protos\screen.proto" />
    <Protobuf Include="protos\pointing.proto" Link="protos\pointing.proto" />
    <Protobuf Include="protos\tensionr.proto" Link="protos\tensionr.proto" />
    <Protobuf Include="protos\streamdeck.proto" Link="protos\streamdeck.proto" />
    <Protobuf Include="protos\driving.proto" Link="protos\driving.proto" />
    <Protobuf Include="protos\camera.proto" Link="protos\camera.proto" />
    <Protobuf Include="protos\carla.proto" Link="protos\carla.proto" />
  </ItemGroup>

  <PropertyGroup>
    <BuildTime>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))</BuildTime>
  </PropertyGroup>

  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile">
    <WriteLinesToFile
      File="$(IntermediateOutputPath)BuildInfo.cs"
      Lines="namespace Core%3B public static class BuildInfo { public static readonly string BuildTime = &quot;$(BuildTime)&quot;%3B }"
      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.cs" />
    </ItemGroup>
  </Target>

</Project>